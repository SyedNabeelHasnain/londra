--- a/app/Domain/TransactionalMailPolicy.php
+++ b/app/Domain/TransactionalMailPolicy.php
@@ -0,0 +1,12 @@
+<?php
+declare(strict_types=1);
+namespace App\Domain;
+final class TransactionalMailPolicy
+{
+    public static function allowed(string $host, bool $ownerApproved): bool
+    {
+        $hostname = strtolower(trim($host));
+        if (!$ownerApproved || $hostname === '') { return false; }
+        return preg_match('~^(?:smtp|smtppro)\.zoho\.(?:com|eu|in|com\.au)$~D', $hostname) !== 1;
+    }
+}
